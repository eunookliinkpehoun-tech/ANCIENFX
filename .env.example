# ================================================================
# ANCIENFX - Variables d'environnement (exemple)
# Copiez ce fichier en .env sur le VPS et remplissez les valeurs.
# NE JAMAIS committer le vrai .env (il est ignore par git).
# ================================================================

# --- Base de donnees MySQL (locale sur le VPS) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ancienfx
DB_USER=root
DB_PASS=votre_mot_de_passe_mysql

# --- Cle secrete des sessions (chaine aleatoire longue) ---
# Generer avec: openssl rand -base64 48
SECRET_KEY=changez_moi_par_une_longue_chaine_aleatoire

# --- MetaApi.cloud (connexion MT4/MT5 + CopyFactory) ---
# Token API recuperable sur https://app.metaapi.cloud (section API tokens).
METAAPI_TOKEN=votre_token_metaapi
# Region de deploiement des comptes (option). Ex: new-york, london, singapore.
METAAPI_REGION=new-york
# Domaine custom MetaApi (option, laisser vide pour le defaut).
METAAPI_DOMAIN=

# ================================================================
# Compte maitre (provider) CopyFactory
# ----------------------------------------------------------------
# Ne se configure PAS ici : il se renseigne via la page /admin de l'app
# (reserve aux utilisateurs avec is_admin = 1).
# ================================================================
