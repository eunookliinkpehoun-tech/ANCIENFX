# ================================================================
# ANCIENFX - Variables d'environnement (exemple)
# Copiez ce fichier en .env sur le VPS et remplissez les valeurs.
# NE JAMAIS committer le vrai .env (il est ignore par git).
# ================================================================

# --- Base de donnees MySQL (locale sur le VPS) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ancienfx
DB_USER=root
DB_PASS=votre_mot_de_passe_mysql

# --- Cle secrete des sessions (chaine aleatoire longue) ---
# Generer avec: openssl rand -base64 48
SECRET_KEY=changez_moi_par_une_longue_chaine_aleatoire

# --- Bridge MT5 (tourne sur le meme VPS) ---
MT5_BRIDGE_URL=http://127.0.0.1:8765
# Secret partage optionnel entre l'app et le bridge (recommande en prod).
# Doit etre identique a la variable BRIDGE_SECRET du bridge Python.
BRIDGE_SECRET=

# ================================================================
# Variables du bridge MT5 (mt5_bridge) - a definir cote Python
# Voir mt5_bridge/README.md pour le detail.
# ================================================================
# COPY_ENABLED=false
# MASTER_LOGIN=436507179
# MASTER_SERVER=Exness-MT5Trial9
# COPY_MODE=balance
# COPY_MULTIPLIER=1.0
# COPY_SLTP=true
